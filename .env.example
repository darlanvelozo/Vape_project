# ============================================================
# Vape Project — variáveis de ambiente (desenvolvimento)
# Copie para .env e ajuste. NUNCA commite o .env.
# ============================================================

# Django
DJANGO_SECRET_KEY=troque-esta-chave
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (docker compose)
POSTGRES_DB=vape_dev
POSTGRES_USER=vape
POSTGRES_PASSWORD=vape
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgres://vape:vape@localhost:5433/vape_dev

# Redis (docker compose)
REDIS_URL=redis://localhost:6380/0

# Frontend
VITE_API_URL=http://localhost:8000/api
